<idea-plugin>
    <id>app.heckit.ide.mailview</id>
    <name>Mail View</name>
    <vendor url="https://heckit.app">heck\it</vendor>

    <description><![CDATA[
<p>
  Read <b>.eml</b>, Outlook <b>.msg</b>/<b>.oft</b>, Apple Mail <b>.emlx</b> and <b>.mht</b> web archives like in a mail client.
  Attachments hidden in Outlook's <b>winmail.dat</b> are unpacked automatically, and <b>.mbox</b> archives are listed mail by mail, right in your IDE - read-only, so your mails stay untouched.
  <b>Mail View</b> shows subject, sender, recipients, the rendered message and attachments instead of encoded MIME text.
</p>

<h3>Views, switchable at the bottom of the editor</h3>
<ul>
  <li><b>Mail</b> (default): subject, from, to, CC, BCC, reply-to and date, followed by the rendered message.
      Embedded images are shown, remote content is blocked until you allow it. Attachments can be opened or saved.</li>
  <li><b>Content</b>: the decoded HTML or plain text part, with syntax highlighting.</li>
  <li><b>Headers</b>: SPF/DKIM/DMARC results and the delivery path with the delay of each hop, followed by all header lines.</li>
  <li><b>Text</b>: the raw file, read-only by default so a mail can't be changed by accident. <i>Edit</i> in the bar above unlocks it; changes show up in the other views right away. (not for .msg/.oft, they are a binary format.)</li>
</ul>

<p><b>macOS:</b> drag mails from Apple Mail onto a folder in the project tree to save them as .eml (after a one-time permission in the settings).</p>

<p>Links in a message open in your system browser. Scripts never run.</p>

<p>Works in all JetBrains IDEs based on the IntelliJ Platform (PhpStorm, IntelliJ IDEA, WebStorm, PyCharm, GoLand, ...). UI available in English and German.</p>

<p>Like Mail View? You can support it via <a href="https://github.com/sponsors/phse">GitHub Sponsors</a> or <a href="https://ko-fi.com/phse_de">buy me a coffee on Ko-fi</a>. More tools at <a href="https://heckit.app">heckit.app</a>.</p>

<p>Missing a feature, have an idea, or just want to share feedback? I would love to hear from you: <a href="mailto:plugin-mail-view@heckit.app">plugin-mail-view@heckit.app</a>.</p>
]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <resource-bundle>messages.MailViewBundle</resource-bundle>

    <projectListeners>
        <listener class="app.heckit.ide.mailview.MailTabSelector" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="app.heckit.ide.mailview.MailDropInstaller" topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Fehler- und Freeze-Berichte der Nutzer landen im Marketplace (Reiter Freezes bzw. Errors). -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <fileType name="EML" implementationClass="app.heckit.ide.mailview.EmlFileType" fieldName="INSTANCE"
                  extensions="eml;emlx;mht;mhtml"/>
        <fileType name="Outlook MSG" implementationClass="app.heckit.ide.mailview.MsgFileType" fieldName="INSTANCE"
                  extensions="msg;oft"/>
        <fileType name="Outlook TNEF" implementationClass="app.heckit.ide.mailview.TnefFileType" fieldName="INSTANCE"
                  extensions="tnef" fileNames="winmail.dat"/>
        <fileType name="MBOX" implementationClass="app.heckit.ide.mailview.MboxFileType" fieldName="INSTANCE"
                  extensions="mbox;mbx"/>
        <fileEditorProvider id="mail-view-mbox" order="first"
                            implementation="app.heckit.ide.mailview.MboxEditorProvider"/>
        <fileEditorProvider id="mail-view-preview" order="first"
                            implementation="app.heckit.ide.mailview.MailPreviewEditorProvider"/>
        <fileEditorProvider id="mail-view-content" order="after mail-view-preview"
                            implementation="app.heckit.ide.mailview.MailContentEditorProvider"/>
        <fileEditorProvider id="mail-view-headers" order="after mail-view-content"
                            implementation="app.heckit.ide.mailview.MailHeaderEditorProvider"/>
        <notificationGroup id="Mail View" displayType="BALLOON" key="notification.group" bundle="messages.MailViewBundle"/>
        <applicationConfigurable parentId="tools" id="app.heckit.ide.mailview" instance="app.heckit.ide.mailview.MailViewConfigurable"
                                 key="settings.title" bundle="messages.MailViewBundle"/>
        <editorFactoryListener implementation="app.heckit.ide.mailview.MboxSeparators"/>
        <editorFactoryListener implementation="app.heckit.ide.mailview.MailTextContextMenu"/>
        <postStartupActivity implementation="app.heckit.ide.mailview.ScreenshotStarter"/>
        <postStartupActivity implementation="app.heckit.ide.mailview.MailDropInstaller$Startup"/>
        <editorNotificationProvider implementation="app.heckit.ide.mailview.MailEditModeNotificationProvider"/>
        <editorNotificationProvider implementation="app.heckit.ide.mailview.MailSourceNotificationProvider"/>
        <editorFactoryDocumentListener implementation="app.heckit.ide.mailview.MailSourceDocumentListener"/>
    </extensions>
    <actions>
        <action id="MailView.OpenSettings" class="app.heckit.ide.mailview.OpenMailViewSettingsAction"/>
        <group id="MailView.EditorPopup" class="app.heckit.ide.mailview.MailEditorPopupGroup"/>
        <action id="MailView.OpenFromClipboard" class="app.heckit.ide.mailview.OpenMailFromClipboardAction">
            <add-to-group group-id="FileOpenGroup" anchor="last"/>
        </action>
        <action id="MailView.ShowInMailView" class="app.heckit.ide.mailview.ShowInMailViewAction" icon="/icons/eml.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
